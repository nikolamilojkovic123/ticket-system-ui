@using Microsoft.Extensions.Localization
@using TicketSystem.UI.Resources
@inject IStringLocalizer<AppResources> L

<div class="ai-body">

    @foreach (var msg in Messages)
    {
        <AiMessageBubble Message="msg" />
    }

</div>

<div class="ai-input">
    <InputText @bind-Value="input"
               class="form-control me-2"
               placeholder="@L["AskSomething"]" />

    <button class="btn btn-primary" @onclick="Send">
        @L["Send"]
    </button>
</div>
