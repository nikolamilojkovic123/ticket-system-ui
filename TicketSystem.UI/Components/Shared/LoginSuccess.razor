@page "/login-callback"
@inject NavigationManager Nav
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@using TicketSystem.UI.Resources
@inject IStringLocalizer<AppResources> L

<p>@L["LoggingIn"]</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var token))
        {
            var jwt = token.ToString();

            await LocalStorage.SetItemAsync("authToken", jwt);

            var customProvider = (CustomAuthStateProvider)AuthStateProvider;
            customProvider.MarkUserAsAuthenticated(jwt);

            Nav.NavigateTo("/", forceLoad: true);
        }
        else
        {
            Nav.NavigateTo("/login-error");
        }
    }
}