@page "/tickets"
@using TicketSystem.UI.Enums

<div class="page-header d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 class="fw-bold mb-1">@L["MyTickets"]</h2>
        <p class="text-muted small mb-0">@L["TicketsDescription"]</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="view-toggle">
            <button class="view-toggle-btn @(!_isKanbanView ? "active" : "")" title="@L["TableView"]" @onclick="SwitchToTable">
                <i class="bi bi-table"></i>
            </button>
            <button class="view-toggle-btn @(_isKanbanView ? "active" : "")" title="@L["KanbanView"]" @onclick="SwitchToKanban">
                <i class="bi bi-kanban"></i>
            </button>
        </div>
        <button class="btn btn-primary px-4 shadow-sm" @onclick="GoToCreate">
            <i class="bi bi-plus-lg me-2"></i>@L["NewTicket"]
        </button>
    </div>
</div>

@if (!_isKanbanView)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body pb-2">
            <div class="input-group mb-3">
                <input type="text" class="form-control"
                       placeholder="@L["SemanticTicketSearch"]"
                       @bind="searchQuery" @onkeyup="HandleKeyUp" />
                <button class="btn btn-primary px-4" @onclick="PerformSearch" disabled="@isLoading">
                    @if (isLoading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    else { <i class="bi bi-search me-2"></i> }
                    @L["SearchTickets"]
                </button>
                @if (!string.IsNullOrWhiteSpace(searchQuery) || isSearching)
                {
                    <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
                <button class="btn @(_showFilters ? "btn-primary" : "btn-outline-secondary") filter-toggle-btn ms-1"
                        @onclick="() => _showFilters = !_showFilters">
                    <i class="bi bi-funnel me-1"></i>
                    @L["Filters"]
                    @if (_filter.ActiveCount > 0)
                    {
                        <span class="filter-count-badge">@_filter.ActiveCount</span>
                    }
                </button>
            </div>

            @if (_showFilters)
            {
                <div class="filter-panel">
                    <div class="filter-row">
                        <span class="filter-label">@L["Status"]</span>
                        <div class="filter-chips">
                            @foreach (var s in Enum.GetValues<TicketStatus>())
                            {
                                <button class="filter-chip @(_filter.Statuses.Contains(s) ? "active " + GetStatusChipClass(s) : "")"
                                        @onclick="() => ToggleFilter(_filter.Statuses, s)">
                                    <span class="chip-dot @GetStatusDotClass(s)"></span>
                                    @GetStatusLabel(s)
                                </button>
                            }
                        </div>
                    </div>

                    <div class="filter-row">
                        <span class="filter-label">@L["Priority"]</span>
                        <div class="filter-chips">
                            @foreach (var p in Enum.GetValues<TicketPriority>())
                            {
                                <button class="filter-chip @(_filter.Priorities.Contains(p) ? "active " + GetPriorityChipClass(p) : "")"
                                        @onclick="() => ToggleFilter(_filter.Priorities, p)">
                                    @GetPriorityIcon(p) @p
                                </button>
                            }
                        </div>
                    </div>

                    <div class="filter-row">
                        <span class="filter-label">@L["Priority"]</span>
                        <div class="filter-chips">
                            @foreach (var c in Enum.GetValues<TicketCategory>())
                            {
                                <button class="filter-chip @(_filter.Categories.Contains(c) ? "active chip-category" : "")"
                                        @onclick="() => ToggleFilter(_filter.Categories, c)">
                                    <i class="bi @GetCategoryIcon(c) me-1"></i>@c
                                </button>
                            }
                        </div>
                    </div>

                    <div class="filter-row">
                        <span class="filter-label">@L["Assignee"]</span>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <select class="form-select form-select-sm filter-select"
                                    @onchange="OnAssigneeChanged">
                                <option value="">@L["All"]</option>
                                @foreach (var u in _users)
                                {
                                    <option value="@u.Id" selected="@(_filter.AssigneeId == u.Id)">@u.Name</option>
                                }
                            </select>

                            <div class="d-flex align-items-center gap-2">
                                <span class="filter-label mb-0">@L["From"]</span>
                                <input type="date" class="form-control form-control-sm filter-date"
                                       value="@(_filter.DateFrom?.ToString("yyyy-MM-dd") ?? "")"
                                       @onchange="e => OnDateChanged(e, isFrom: true)" />
                                <span class="filter-label mb-0">@L["To"]</span>
                                <input type="date" class="form-control form-control-sm filter-date"
                                       value="@(_filter.DateTo?.ToString("yyyy-MM-dd") ?? "")"
                                       @onchange="e => OnDateChanged(e, isFrom: false)" />
                            </div>
                        </div>
                    </div>

                    @if (!_filter.IsEmpty)
                    {
                        <div class="filter-row border-top pt-2 mt-1">
                            <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none" @onclick="ClearFilters">
                                <i class="bi bi-x-circle me-1"></i>@L["ResetAllFilters"]
                            </button>
                        </div>
                    }
                </div>
            }

            @if (!_filter.IsEmpty)
            {
                <div class="active-filters">
                    @foreach (var s in _filter.Statuses)
                    {
                        <span class="active-chip">
                            @GetStatusLabel(s)
                            <button @onclick="() => ToggleFilter(_filter.Statuses, s)"><i class="bi bi-x"></i></button>
                        </span>
                    }
                    @foreach (var p in _filter.Priorities)
                    {
                        <span class="active-chip">
                            @p
                            <button @onclick="() => ToggleFilter(_filter.Priorities, p)"><i class="bi bi-x"></i></button>
                        </span>
                    }
                    @foreach (var c in _filter.Categories)
                    {
                        <span class="active-chip">
                            @c
                            <button @onclick="() => ToggleFilter(_filter.Categories, c)"><i class="bi bi-x"></i></button>
                        </span>
                    }
                    @if (_filter.AssigneeId.HasValue)
                    {
                        <span class="active-chip">
                            @(_users.FirstOrDefault(u => u.Id == _filter.AssigneeId)?.Name ?? "Assignee")
                            <button @onclick="() => { _filter.AssigneeId = null; ApplyFilters(); }"><i class="bi bi-x"></i></button>
                        </span>
                    }
                    @if (_filter.DateFrom.HasValue)
                    {
                        <span class="active-chip">
                            @L["From"] @_filter.DateFrom.Value.ToString("dd.MM.yyyy")
                            <button @onclick="() => { _filter.DateFrom = null; ApplyFilters(); }"><i class="bi bi-x"></i></button>
                        </span>
                    }
                    @if (_filter.DateTo.HasValue)
                    {
                        <span class="active-chip">
                            @L["To"] @_filter.DateTo.Value.ToString("dd.MM.yyyy")
                            <button @onclick="() => { _filter.DateTo = null; ApplyFilters(); }"><i class="bi bi-x"></i></button>
                        </span>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body pb-2">
            <div class="filter-panel">
                <div class="filter-row">
                    <span class="filter-label">@L["Status"]</span>
                    <div class="filter-chips">
                        @foreach (var s in Enum.GetValues<TicketStatus>())
                        {
                            <button class="filter-chip @(_filter.Statuses.Contains(s) ? "active " + GetStatusChipClass(s) : "")"
                                    @onclick="() => ToggleFilter(_filter.Statuses, s)">
                                <span class="chip-dot @GetStatusDotClass(s)"></span>
                                @GetStatusLabel(s)
                            </button>
                        }
                    </div>
                </div>
                <div class="filter-row">
                    <span class="filter-label">@L["Priority"]</span>
                    <div class="filter-chips">
                        @foreach (var p in Enum.GetValues<TicketPriority>())
                        {
                            <button class="filter-chip @(_filter.Priorities.Contains(p) ? "active " + GetPriorityChipClass(p) : "")"
                                    @onclick="() => ToggleFilter(_filter.Priorities, p)">
                                @GetPriorityIcon(p) @p
                            </button>
                        }
                    </div>
                </div>
                <div class="filter-row">
                    <span class="filter-label">@L["Category"]</span>
                    <div class="filter-chips">
                        @foreach (var c in Enum.GetValues<TicketCategory>())
                        {
                            <button class="filter-chip @(_filter.Categories.Contains(c) ? "active chip-category" : "")"
                                    @onclick="() => ToggleFilter(_filter.Categories, c)">
                                <i class="bi @GetCategoryIcon(c) me-1"></i>@c
                            </button>
                        }
                    </div>
                </div>
                @if (!_filter.IsEmpty)
                {
                    <div class="filter-row border-top pt-2 mt-1">
                        <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none" @onclick="ClearFilters">
                            <i class="bi bi-x-circle me-1"></i>@L["ResetAllFilters"]
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-danger"></div>
    </div>
}
else if (_isKanbanView)
{
    var visibleTickets = KanbanFilteredTickets;
    <div class="kanban-board">
        @foreach (var col in _columns)
        {
            var colTickets = visibleTickets.Where(t => t.Status == col.Status).ToList();
            <div class="kanban-column @(_dragOverColumn == col.Status ? "drag-over" : "")"
                 @ondragover:preventDefault
                 @ondragover="() => _dragOverColumn = col.Status"
                 @ondragleave="() => { if (_dragOverColumn == col.Status) _dragOverColumn = null; }"
                 @ondrop="() => OnDrop(col.Status)">

                <div class="kanban-col-header">
                    <span class="kanban-col-dot @col.DotClass"></span>
                    <span class="kanban-col-title">@col.Label</span>
                    <span class="kanban-col-count">@colTickets.Count</span>
                </div>

                <div class="kanban-cards">
                    @if (!colTickets.Any())
                    {
                        <div class="kanban-empty">
                            <i class="bi bi-inbox"></i>
                            <span>@L["NoTickets"]</span>
                        </div>
                    }
                    @foreach (var ticket in colTickets)
                    {
                        <div class="kanban-card @(_dragging?.Id == ticket.Id ? "is-dragging" : "")"
                             draggable="true"
                             @ondragstart="() => OnDragStart(ticket)"
                             @ondragend="OnDragEnd"
                             @onclick="() => OpenDetails(ticket.Id)">
                            <div class="kanban-card-title">@ticket.Title</div>
                            <div class="d-flex align-items-center justify-content-between mt-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi @GetCategoryIcon(ticket.Category) text-muted" style="font-size:0.8rem;"></i>
                                    <span class="badge @GetPriorityClass(ticket.Priority)">@ticket.Priority</span>
                                </div>
                                @if (!string.IsNullOrEmpty(ticket.Name))
                                {
                                    <div class="kanban-assignee" title="@ticket.Name">
                                        @ticket.Name.FirstOrDefault().ToString().ToUpper()
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else if (TableFilteredTickets?.Any() != true)
{
    <div class="text-center my-5 p-5 bg-white rounded shadow-sm">
        <i class="bi bi-clipboard-x fs-1 text-muted"></i>
        <h4 class="mt-3">@(_filter.IsEmpty ? L["NoTickets"] : L["NoFilterResults"])</h4>
        <p class="text-muted">@(_filter.IsEmpty ? L["NoTicketsDesc"] : L["TryDifferentFilters"])</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm overflow-hidden position-relative">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-2">@L["Title"]</th>
                        <th class="ps-2">@L["Assignee"]</th>
                        <th>@L["Category"]</th>
                        <th>@L["Priority"]</th>
                        <th>@L["Status"]</th>
                        <th class="text-end pe-4">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in TableFilteredTickets!)
                    {
                        <tr style="cursor:pointer" @onclick="() => OpenDetails(t.Id)">
                            <td class="ps-2 fw-medium">@t.Title</td>
                            <td class="ps-2">@t.Name</td>
                            <td><i class="bi @GetCategoryIcon(t.Category) me-2"></i>@t.Category</td>
                            <td><span class="badge @GetPriorityClass(t.Priority)">@t.Priority</span></td>
                            <td>
                                <span class="status-dot @GetStatusClass(t.Status) me-2"></span>@t.Status
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-light border"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenDetails(t.Id)">
                                    <i class="bi bi-eye me-1"></i>@L["Details"]
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">@string.Format(L["PageOf"], currentPage, TotalPages)</span>
                <select class="form-select form-select-sm w-auto" @bind="pageSize" @bind:after="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="15">15</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <span class="text-muted small">@L["PerPage"]</span>
            </div>
            <div class="btn-group">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(!HasPrev)" @onclick="PrevPage">@L["Prev"]</button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(!HasNext)" @onclick="NextPage">@L["Next"]</button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center bg-white bg-opacity-75">
                <div class="spinner-border text-danger"></div>
            </div>
        }
    </div>
}
