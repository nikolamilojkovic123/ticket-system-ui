@page "/forgot-password"

<div class="auth-page d-flex align-items-center justify-content-center py-5">
    <div class="auth-card card border-0 shadow-sm p-4">
        <h3 class="fw-bold mb-4 text-center">@L["ForgotPasswordLink"]</h3>

        @if (linkSent)
        {
            <p class="text-center">@L["ResetLinkSentMessage"]</p>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">@L["Email"]</label>
                    <InputText class="form-control" @bind-Value="model.Email" type="email" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                    @L["SendResetLink"]
                </button>
            </EditForm>
        }

        <p class="text-center small mt-3 mb-0">
            <a href="/login">@L["BackToLogin"]</a>
        </p>
    </div>
</div>
