@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using TicketSystem.UI.Resources
@inject IStringLocalizer<AppResources> L

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <div class="alert alert-warning m-5">
                            <h4>@L["NotLoggedIn"]</h4>
                            <p>@L["NotLoggedInDescription"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger m-5">
                            <h4>@L["AccessDenied"]</h4>
                            <p>@L["AccessDeniedDescription"]</p>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>404 - @L["NotFound"]</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">

            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>