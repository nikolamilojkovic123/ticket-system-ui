@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <div class="container py-5 animate-fade-in">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <h2 class="fw-bold mb-1">
                        @L["WelcomeBack", context.User.Identity?.Name ?? "User"]
                    </h2>
                    <p class="text-muted mb-0">@L["TicketsToday"]</p>
                </div>
                <button class="btn btn-primary px-4 shadow-sm"
                        @onclick='() => Nav.NavigateTo("/ticket/create")'>
                    <i class="bi bi-plus-lg me-2"></i>@L["NewTicket"]
                </button>
            </div>

            @if (isLoading)
            {
                <div class="row g-4 mb-4">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="col-6 col-lg-3">
                            <div class="stats-card p-4 bg-white shadow-sm border-0 rounded-4 placeholder-glow">
                                <span class="placeholder col-6 mb-2"></span>
                                <span class="placeholder col-4 d-block" style="height:2rem;"></span>
                                <span class="placeholder col-12 mt-3" style="height:6px;"></span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="row g-4 mb-4">
                    <div class="col-6 col-lg-3">
                        <div class="stats-card clickable-card p-4 bg-white shadow-sm border-0 rounded-4"
                             @onclick='() => Nav.NavigateTo("/tickets")'>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="stat-label">@L["ActiveTickets"]</span>
                                <div class="stat-icon-wrap bg-primary bg-opacity-10">
                                    <i class="bi bi-ticket-perforated text-primary card-icon"></i>
                                </div>
                            </div>
                            <div class="stat-value mt-3">@dashboard.TotalTickets</div>
                            <div class="progress mt-3" style="height:5px;">
                                <div class="progress-bar bg-primary" style="width:100%"></div>
                            </div>
                            <div class="card-footer-link mt-3">
                                <span>@L["ViewAll"]</span>
                                <i class="bi bi-arrow-right"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="stats-card clickable-card p-4 bg-white shadow-sm border-0 rounded-4"
                             @onclick='() => Nav.NavigateTo("/tickets")'>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="stat-label">@L["Open"]</span>
                                <div class="stat-icon-wrap bg-warning bg-opacity-10">
                                    <i class="bi bi-envelope-open text-warning card-icon"></i>
                                </div>
                            </div>
                            <div class="stat-value mt-3">@dashboard.OpenTickets</div>
                            <div class="progress mt-3" style="height:5px;">
                                <div class="progress-bar bg-warning"
                                     style="width:@(dashboard.TotalTickets > 0 ? $"{dashboard.OpenTickets * 100 / dashboard.TotalTickets}%" : "0%")">
                                </div>
                            </div>
                            <div class="card-footer-link mt-3">
                                <span>@L["ViewAll"]</span>
                                <i class="bi bi-arrow-right"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="stats-card clickable-card p-4 bg-white shadow-sm border-0 rounded-4"
                             @onclick='() => Nav.NavigateTo("/tickets")'>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="stat-label">@L["InProgress"]</span>
                                <div class="stat-icon-wrap bg-info bg-opacity-10">
                                    <i class="bi bi-arrow-repeat text-info card-icon"></i>
                                </div>
                            </div>
                            <div class="stat-value mt-3">@dashboard.InProgressTickets</div>
                            <div class="progress mt-3" style="height:5px;">
                                <div class="progress-bar bg-info"
                                     style="width:@(dashboard.TotalTickets > 0 ? $"{dashboard.InProgressTickets * 100 / dashboard.TotalTickets}%" : "0%")">
                                </div>
                            </div>
                            <div class="card-footer-link mt-3">
                                <span>@L["ViewAll"]</span>
                                <i class="bi bi-arrow-right"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="stats-card clickable-card p-4 bg-white shadow-sm border-0 rounded-4"
                             @onclick='() => Nav.NavigateTo("/tickets")'>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="stat-label">@L["Resolved"]</span>
                                <div class="stat-icon-wrap bg-success bg-opacity-10">
                                    <i class="bi bi-check-circle text-success card-icon"></i>
                                </div>
                            </div>
                            <div class="stat-value mt-3">@dashboard.ResolvedTickets</div>
                            <div class="progress mt-3" style="height:5px;">
                                <div class="progress-bar bg-success"
                                     style="width:@(dashboard.TotalTickets > 0 ? $"{dashboard.ResolvedTickets * 100 / dashboard.TotalTickets}%" : "0%")">
                                </div>
                            </div>
                            <div class="card-footer-link mt-3">
                                <span>@L["ViewAll"]</span>
                                <i class="bi bi-arrow-right"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="stats-card clickable-card p-4 bg-white shadow-sm border-0 rounded-4"
                             @onclick='() => Nav.NavigateTo("/tickets")'>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="stat-label">@L["AiHealth"]</span>
                                <div class="stat-icon-wrap bg-danger bg-opacity-10">
                                    <i class="bi bi-activity text-danger card-icon"></i>
                                </div>
                            </div>
                            <div class="d-flex align-items-baseline gap-2 mb-3">
                                <span class="stat-value">@dashboard.AverageSeverity.ToString("0.0")%</span>
                                <span class="badge @SeverityBadgeClass">@SeverityLabel</span>
                            </div>
                            <div class="progress" style="height:8px; border-radius:4px;">
                                <div class="progress-bar @SeverityBarClass"
                                     style="width:@dashboard.AverageSeverity%; transition: width 0.6s ease;">
                                </div>
                            </div>
                            <div class="card-footer-link mt-3">
                                <span>@L["ViewAll"]</span>
                                <i class="bi bi-arrow-right"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="stats-card clickable-card p-4 bg-white shadow-sm border-0 rounded-4"
                             @onclick='() => Nav.NavigateTo("/tickets")'>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="stat-label">@L["CriticalTickets"]</span>
                                <div class="stat-icon-wrap bg-danger bg-opacity-10">
                                    <i class="bi bi-exclamation-triangle text-danger card-icon"></i>
                                </div>
                            </div>
                            <div class="stat-value">@dashboard.CriticalCount</div>
                            <p class="text-danger small mb-0 mt-1">@L["AiDetectedRisk"]</p>
                            <div class="progress mt-3" style="height:8px; border-radius:4px;">
                                <div class="progress-bar bg-danger"
                                     style="width:@(dashboard.TotalTickets > 0 ? $"{dashboard.CriticalCount * 100 / dashboard.TotalTickets}%" : "0%"); transition: width 0.6s ease;">
                                </div>
                            </div>
                            <div class="card-footer-link mt-3">
                                <span>@L["ViewAll"]</span>
                                <i class="bi bi-arrow-right"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 p-4 bg-light rounded-4 border border-dashed text-center">
                    <h5 class="fw-bold">@L["AiHelpTitle"]</h5>
                    <p class="text-muted mb-3">@L["AiHelpDesc"]</p>
                    <div class="d-flex justify-content-center gap-2">
                        <button class="btn btn-outline-dark btn-sm px-4"
                                @onclick='() => Nav.NavigateTo("/tickets")'>
                            @L["ViewAllTickets"]
                        </button>
                        <button class="btn btn-outline-primary btn-sm px-4"
                                @onclick='() => Nav.NavigateTo("/document-ai")'>
                            <i class="bi bi-robot me-1"></i>@L["OpenAi"]
                        </button>
                    </div>
                </div>
            }
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="landing-hero d-flex align-items-center overflow-hidden">
            <div class="container">
                <div class="row align-items-center vh-100">
                    <div class="col-lg-6 animate-slide-left">

                        <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill mb-3">
                            @L["AiPoweredSupport"]
                        </span>

                        <h1 class="display-3 fw-bold mb-3">
                            @L["LandingTitle"]
                        </h1>

                        <p class="lead text-muted mb-4">
                            @L["LandingDesc"]
                        </p>

                        <div class="d-flex gap-3">
                            <button class="btn btn-primary btn-lg px-5 rounded-pill shadow-lg"
                                    @onclick="LoginWithGoogle">
                                <i class="bi bi-google me-2"></i> @L["StartWithGoogle"]
                            </button>
                        </div>
                    </div>

                    <div class="col-lg-6 text-center animate-float">
                        <dotlottie-player src="https://lottie.host/8e7514a6-4a16-43d9-a784-984022c06950/LpU7YI9D6C.json"
                                          background="transparent"
                                          speed="1"
                                          style="width: 100%; height: 500px;"
                                          loop
                                          autoplay>
                        </dotlottie-player>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
