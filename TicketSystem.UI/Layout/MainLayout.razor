@using TicketSystem.UI.Components.Shared
@using TicketSystem.UI.Components.Shared.Notifications
@using TicketSystem.UI.Services
@inherits LayoutComponentBase

<div class="page">

    <div class="mobile-topbar">
        <button class="mobile-hamburger-btn" @onclick="ToggleMobileMenu">
            <i class="bi bi-list fs-4"></i>
        </button>
        <div class="mobile-brand">
            <div class="mobile-brand-logo">
                <i class="bi bi-cpu-fill"></i>
            </div>
            <span>CommsCenter AI</span>
        </div>

        <button class="mobile-bell-btn ms-auto" @onclick="NotificationService.TogglePanel">
            <div class="mobile-bell-wrap">
                <i class="bi bi-bell fs-5"></i>
                @if (NotificationService.UnreadCount > 0)
                {
                    <span class="mobile-bell-badge">@(NotificationService.UnreadCount > 9 ? "9+" : NotificationService.UnreadCount.ToString())</span>
                }
            </div>
        </button>
    </div>

    @if (isMobileMenuOpen)
    {
        <div class="sidebar-overlay" @onclick="CloseMobileMenu"></div>
    }

    <div class="sidebar @(isMobileMenuOpen ? "mobile-open" : "")">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>

</div>

<NotificationPanel />
<ToastContainer />
