@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using TicketSystem.UI.Services
@using Microsoft.Extensions.Localization
@using TicketSystem.UI.Resources

<div class="sidebar-container @(isCollapsed ? "collapsed" : "")">

    <div class="brand-section">
        <div class="brand-logo">
            <i class="bi bi-cpu-fill"></i>
        </div>
        <span class="brand-name">CommsCenter AI</span>
        <button type="button" class="sidebar-toggle-btn" @onclick="ToggleSidebar" title="Toggle sidebar">
            <i class="bi @(isCollapsed ? "bi-layout-sidebar" : "bi-layout-sidebar-reverse")"></i>
        </button>
    </div>

    <nav class="nav-section">
        <ul class="nav-list">

            <li class="nav-item-wrapper">
                <NavLink class="nav-link-item" href="/" Match="NavLinkMatch.All" title="@L["Home"]">
                    <i class="bi bi-house-door nav-icon"></i>
                    <span class="nav-label">@L["Home"]</span>
                </NavLink>
            </li>

            <AuthorizeView Context="authContext">
                <Authorized>

                    <li class="nav-group-label"><span>@L["MainMenu"]</span></li>

                    <li class="nav-item-wrapper">
                        <NavLink class="nav-link-item" href="/tickets" title="@L["MyTickets"]">
                            <i class="bi bi-ticket-perforated nav-icon"></i>
                            <span class="nav-label">@L["MyTickets"]</span>
                        </NavLink>
                    </li>

                    <li class="nav-item-wrapper">
                        <NavLink class="nav-link-item" href="/ticket/create" title="@L["NewTicket"]">
                            <i class="bi bi-plus-circle nav-icon"></i>
                            <span class="nav-label">@L["NewTicket"]</span>
                        </NavLink>
                    </li>

                    <li class="nav-item-wrapper">
                        <NavLink class="nav-link-item" href="/document-ai" title="@L["AiDocuments"]">
                            <i class="bi bi-robot nav-icon"></i>
                            <span class="nav-label">@L["AiDocuments"]</span>
                        </NavLink>
                    </li>

                    <li class="nav-item-wrapper">
                        <button type="button" class="nav-link-item" @onclick="NotificationService.TogglePanel" title="@L["Notifications"]">
                            <span class="nav-icon-badge">
                                <i class="bi bi-bell nav-icon"></i>
                                @if (NotificationService.UnreadCount > 0)
                                {
                                    <span class="badge-dot">@(NotificationService.UnreadCount > 9 ? "9+" : NotificationService.UnreadCount.ToString())</span>
                                }
                            </span>
                            <span class="nav-label">@L["Notifications"]</span>
                        </button>
                    </li>

                    <li class="nav-item-wrapper">
                        <NavLink class="nav-link-item" href="/profile" title="@L["Profile"]">
                            <i class="bi bi-person-circle nav-icon"></i>
                            <span class="nav-label">@L["Profile"]</span>
                        </NavLink>
                    </li>

                    <li class="nav-item-wrapper">
                        <NavLink class="nav-link-item" href="/settings" title="@L["Settings"]">
                            <i class="bi bi-gear nav-icon"></i>
                            <span class="nav-label">@L["Settings"]</span>
                        </NavLink>
                    </li>

                    <AuthorizeView Roles="Admin" Context="adminContext">
                        <Authorized>
                            <li class="nav-group-label"><span>@L["System"]</span></li>
                            <li class="nav-item-wrapper">
                                <NavLink class="nav-link-item nav-admin" href="/admin" title="@L["AdminPanel"]">
                                    <i class="bi bi-shield-lock nav-icon"></i>
                                    <span class="nav-label">@L["AdminPanel"]</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>

                </Authorized>
            </AuthorizeView>

        </ul>
    </nav>

    <div class="sidebar-footer">

        <AuthorizeView Context="userContext">
            <Authorized>
                <div class="user-card">
                    <div class="user-avatar">
                        @userContext.User.Identity?.Name?[0]
                    </div>
                    <div class="user-info">
                        <span class="user-name">@userContext.User.Identity?.Name</span>
                        <span class="user-email">@userContext.User.FindFirst(c => c.Type == "email")?.Value</span>
                    </div>
                    <button type="button" class="logout-btn" @onclick="Logout" title="@L["Logout"]">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <button type="button" class="google-login-btn" @onclick="LoginGoogle">
                    <i class="bi bi-google"></i>
                    <span class="nav-label">@L["Login"]</span>
                </button>
                <NavLink class="nav-link-item small text-center" href="/login">
                    <span class="nav-label">@L["OrContinueWithEmail"]</span>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>

    </div>

</div>
